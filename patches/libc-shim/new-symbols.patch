diff --git a/src/errno.cpp b/src/errno.cpp
index be6c818..1ef9960 100644
--- a/src/errno.cpp
+++ b/src/errno.cpp
@@ -17,6 +17,13 @@ int shim::strerror_r(int err, char* buf, size_t len) {
 #endif
 }
 
+// GNU variant (used by newer libpairipcore): returns the message instead of a status code
+char *shim::gnu_strerror_r(int err, char* buf, size_t len) {
+    if (shim::strerror_r(err, buf, len) != 0 && len > 0)
+        buf[0] = '\0';
+    return buf;
+}
+
 #ifdef ERRNO_TRANSLATION
 
 thread_local int shim::bionic::errno_value;
